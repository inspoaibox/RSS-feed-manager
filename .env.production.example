# RSS Manager 生产环境配置示例
# 复制此文件为 .env.production 并修改以下值
# 默认轻量模式启动命令（不拉取 browser 大镜像）:
# docker compose -f docker-compose.prod.yml -f docker-compose.prod.build.yml --env-file .env.production pull
# docker compose -f docker-compose.prod.yml -f docker-compose.prod.build.yml --env-file .env.production up -d
# 浏览器抓取模式启动命令（需要 Playwright/CloakBrowser 时使用）:
# docker compose --profile browser -f docker-compose.prod.yml -f docker-compose.prod.build.yml --env-file .env.production pull
# docker compose --profile browser -f docker-compose.prod.yml -f docker-compose.prod.build.yml --env-file .env.production up -d

# ============ 必须修改 ============

# 数据库密码（请使用强密码）
POSTGRES_PASSWORD=your_strong_database_password_here

# Redis 密码（请使用强密码）
REDIS_PASSWORD=your_strong_redis_password_here

# JWT 密钥（请生成随机字符串，至少32位）
# 可以使用: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_key_at_least_32_characters_long

# CORS 允许的域名（前端访问地址）
# 如果使用 IP+端口访问，设置为: ["http://你的IP:5666"]
# 如果使用域名访问，设置为: ["https://your-domain.com"]
CORS_ORIGINS=["http://localhost:5666"]

# ============ 可选修改 ============

# 数据库用户名
POSTGRES_USER=rss_manager

# 数据库名
POSTGRES_DB=rss_manager

# 网站基础 URL（用于 OAuth 回调等）
# 如果使用域名访问，设置为: https://your-domain.com
BASE_URL=https://your-domain.com

# Docker 镜像标签
# 默认使用 GitHub Actions 发布到 GHCR 的 latest 镜像。
# 如需固定到某次提交，可改为 sha-完整提交SHA。
RSS_MANAGER_IMAGE_TAG=latest

# 浏览器抓取 Worker 是可选服务。需要 Playwright/CloakBrowser 抓取时，
# 可以在 docker compose 命令中添加 --profile browser；
# 也可以取消下一行注释，让每次 compose 默认启用 browser profile。
# COMPOSE_PROFILES=browser

# ============ 抓取队列调优 ============

# 普通 RSS 每分钟最多派发多少个到期抓取任务。
FEED_REFRESH_DISPATCH_LIMIT=100

# 浏览器模式 RSS 每分钟最多派发多少个到期抓取任务；实际同时运行数量由 BROWSER_WORKER_CONCURRENCY 控制。
FEED_BROWSER_REFRESH_DISPATCH_LIMIT=50

# 浏览器抓取 Worker 并发数。服务器内存较小时可调低。
BROWSER_WORKER_CONCURRENCY=3

# 浏览器抓取 Worker 每个子进程处理多少任务后自动回收，用于释放长期运行后的残留内存。
BROWSER_WORKER_MAX_TASKS_PER_CHILD=20

# 自定义规则每分钟最多派发多少个到期任务。
CUSTOM_RULE_DISPATCH_LIMIT=10

# 使用 Playwright 的自定义规则每分钟最多派发多少个到期任务。
CUSTOM_RULE_BROWSER_DISPATCH_LIMIT=1
