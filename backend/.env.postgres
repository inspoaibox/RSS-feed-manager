# RSS Manager - PostgreSQL 配置（生产环境）
# 使用方法: copy .env.postgres .env
# 需要先启动 Docker: docker-compose up -d postgres redis

# Application
APP_NAME=RSS Manager
APP_VERSION=0.1.0
DEBUG=false

# Database - PostgreSQL（需要 Docker 或独立安装）
DATABASE_URL=postgresql+asyncpg://rss_manager:rss_manager_password@localhost:5432/rss_manager

# Redis（后台任务必需）
REDIS_URL=redis://localhost:6379/0

# Security - 生产环境请修改为随机字符串！
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - 生产环境请修改为实际域名
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Feed settings
DEFAULT_FETCH_INTERVAL=3600
MAX_ARTICLES_PER_FEED=1000
