FROM python:3.11-slim-bookworm

WORKDIR /app

# Improve reliability on slower package mirrors.
RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "60";\nAcquire::https::Timeout "60";\n' > /etc/apt/apt.conf.d/80-retries

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install base dependencies plus optional browser runtime dependencies.
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --retries 5 --timeout 120 $(python -c "import tomllib; f=open('pyproject.toml','rb'); d=tomllib.load(f); deps=d['project']['dependencies'] + d['project']['optional-dependencies']['browser']; print(' '.join(deps))")

# Install Chromium and OS libraries only in the browser image.
RUN playwright install --with-deps chromium

COPY . .

RUN pip install --no-cache-dir --retries 5 --timeout 120 --no-deps -e .

CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]

EXPOSE 8000
