<Window x:Class="MRSS.Native.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="820"
        Height="680"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="配置刷新，以及手机端/电脑端共享的 GitHub Gist 订阅同步。" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="刷新" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,20">
                    <StackPanel>
                        <CheckBox Content="打开软件后自动刷新所有订阅" IsChecked="{Binding RefreshOnStartup}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="后台刷新间隔（分钟）" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding StartupRefreshMinutes, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="GitHub Gist 订阅同步" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Token" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <PasswordBox x:Name="TokenBox" Grid.Column="1" PasswordChanged="TokenBox_PasswordChanged" />

                        <TextBlock Grid.Row="1" Text="Gist ID" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GistId, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" />

                        <TextBlock Grid.Row="2" Text="文件名" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GistFilename, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" />
                    </Grid>
                </Border>
                <TextBlock Text="Gist 同步只合并分类、订阅源和关键词订阅，不上传本地已保存文章。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="2,8,2,0" />

                <TextBlock Text="AI 翻译" Style="{StaticResource SectionTitle}" Margin="0,22,0,0" />
                <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认翻译语言" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding DefaultTranslationLanguage, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="渠道" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Button Content="新增" Width="68" MinHeight="34" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="AddAiChannel_Click" />
                                </DockPanel>
                                <ListBox x:Name="AiChannelList" Height="188" SelectionChanged="AiChannelList_SelectionChanged" />
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <Button Content="设为默认" MinHeight="34" Style="{StaticResource GhostButton}" Click="DefaultAiChannel_Click" />
                                    <Button Content="删除" MinHeight="34" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="DeleteAiChannel_Click" />
                                </UniformGrid>
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource SoftPanelBorder}" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="渠道名称" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="AiNameBox" Grid.Column="1" TextChanged="AiFieldChanged" />

                                    <TextBlock Grid.Row="1" Text="类型" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                                    <ComboBox x:Name="AiProviderBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" SelectionChanged="AiProviderBox_SelectionChanged">
                                        <ComboBoxItem Content="OpenAI 官方" Tag="openai" />
                                        <ComboBoxItem Content="Gemini 官方" Tag="gemini" />
                                        <ComboBoxItem Content="通义千问" Tag="qwen" />
                                        <ComboBoxItem Content="豆包" Tag="doubao" />
                                        <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                                        <ComboBoxItem Content="Kimi" Tag="kimi" />
                                        <ComboBoxItem Content="智谱" Tag="zhipu" />
                                        <ComboBoxItem Content="OpenAI 兼容" Tag="openai_compatible" />
                                    </ComboBox>

                                    <TextBlock x:Name="AiBaseUrlLabel" Grid.Row="2" Text="Base URL" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                                    <TextBox x:Name="AiBaseUrlBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" TextChanged="AiFieldChanged" />

                                    <TextBlock Grid.Row="3" Text="API Key" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                                    <PasswordBox x:Name="AiKeyBox" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" PasswordChanged="AiKeyBox_PasswordChanged" />

                                    <TextBlock Grid.Row="4" Text="模型/接入点" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                                    <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0">
                                        <Button x:Name="FetchModelsButton" Content="拉取" Width="68" MinHeight="38" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="FetchModels_Click" />
                                        <ComboBox x:Name="AiModelBox" IsEditable="True" SelectionChanged="AiFieldChanged" ToolTip="可选择拉取到的模型，也可手动填写模型名或豆包火山方舟接入点 ID" />
                                    </DockPanel>

                                    <TextBlock x:Name="AiModelStatus" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />

                                    <TextBlock x:Name="AiProviderHint" Grid.Row="6" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="88" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
            <Button Content="保存" Width="88" Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
